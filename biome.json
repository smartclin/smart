{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "preset": "recommended",
        "useSortedAttributes": "on",
        "useSortedKeys": "off",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "tab",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 80
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "files": {
    "includes": [
      "!**/dist",
      "!**/dist",
      "!**/docs",
      "!**/test-data",
      "!**/tests",
      "!**/paraglide",
      "!**/.agents",
      "!**/routeTree.gen.ts",
      "!**/worker-configuration.d.ts",
      "!**/auth-schema.ts",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles.css",
      "!**/.zed",
      "!**/pglite-db",
      "!**/.vscode",
      "!**/assets",
      "!**/src-tauri",
      "!**/.nuxt",
      "!node_modules",
      "!**/generated",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/.source",
      "!**/convex/_generated"
    ],
    "maxSize": 7340032
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "tab",
    "indentWidth": 4,
    "lineEnding": "lf",
    "lineWidth": 80,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "multiline",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "enabled": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    },
    "globals": ["React"]
  },
  "linter": {
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "enabled": true,
    "includes": [
      "**",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!**/*.spec.ts",
      "!**/*.spec.tsx",
      "!**/node_modules",
      "!**/.next",
      "!**/stats.html",
      "!**/.idea"
    ],
    "rules": {
      "a11y": {
        "noAutofocus": "off",
        "noNoninteractiveElementInteractions": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "preset": "recommended",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 80
          }
        },
        "noForEach": "off",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefined": "off",
        "noVoid": "off",
        "preset": "recommended",
        "useArrowFunction": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noConstantCondition": "error",
        "noConstAssign": "off",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "off",
        "noInvalidBuiltinInstantiation": "off",
        "noInvalidConstructorSuper": "off",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "off",
        "noSwitchDeclarations": "error",
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "off",
        "noUnreachable": "off",
        "noUnreachableSuper": "off",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedFunctionParameters": "warn",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "preset": "recommended",
        "useExhaustiveDependencies": "info",
        "useIsNan": "error",
        "useJsxKeyInIterable": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "warn",
          "options": {
            "functions": ["clsx", "cva", "cn"]
          }
        }
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "noImgElement": "off",
        "noNamespaceImport": "off",
        "noJsxPropsBind": "off",
        "preset": "recommended",
        "useTopLevelRegex": "off"
      },
      "preset": "recommended",
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "preset": "recommended"
      },
      "style": {
        "noExportedImports": "off",
        "useDestructuring": "off",
        "noCommonJs": "error",
        "noHeadElement": "off",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "noNestedTernary": "off",
        "noIncrementDecrement": "off",
        "useCollapsedElseIf": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "error",
        "noParameterProperties": "off",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "preset": "recommended",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useConsistentTypeDefinitions": "off",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useFilenamingConvention": "off",
        "useImportType": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noUnnecessaryConditions": "off",
        "noClassAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDocumentCookie": "off",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "off",
        "noDuplicateElseIf": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "off",
        "noDuplicateParameters": "off",
        "noUnknownAttribute": "off",
        "noEmptyBlockStatements": "off",
        "noEvolvingTypes": "off",
        "noLeakedRender": "off",
        "noExplicitAny": "warn",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "off",
        "noGlobalAssign": "error",
        "noImplicitAnyLet": "off",
        "noImportAssign": "off",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noPrototypeBuiltins": "error",
        "noReactSpecificProps": "off",
        "noRedeclare": "off",
        "noShadow": "off",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUnknownAtRules": "off",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "off",
        "noVar": "error",
        "noWith": "off",
        "preset": "recommended",
        "useAwait": "off",
        "useGetterReturn": "off",
        "useNamespaceKeyword": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "performance": {
            "noJsxPropsBind": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noLeakedRender": "off",
            "noRedeclare": "off",
            "noExplicitAny": "off"
          },
          "style": {
            "noExportedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/id-card.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": false,
    "useIgnoreFile": false
  }
}
