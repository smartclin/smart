    "@smart/config": "workspace:*",
    "@tanstack/devtools-a11y": "0.2.2",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/query-async-storage-persister": "5.104.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
