{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "bun --env-file=../../apps/web/.env node_modules/@better-auth/cli/dist/index.mjs generate --config src/services.ts --output ../../db/src/schema/auth.ts",
    "build": "tsc -b ../../packages/api && vite build",
    "check": "biome check --write",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "run": "PORT=8080 bun run server.ts",
    "see": "ASSET_PRELOAD_VERBOSE_LOGGING=true bun run server.ts",
    "start": "bun run src/server.ts",
    "start:e2e": "bun .output/server/index.mjs",
    "tanstack": "bunx @tanstack/router-cli generate",
    "verify": "bun run check-types && bun run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "^1.15.4",
    "@orpc/zod": "catalog:",
    "@rolldown/plugin-babel": "0.2.4",
    "@smart/api": "workspace:*",
    "@smart/auth": "workspace:*",
    "@smart/db": "workspace:*",
    "@smart/env": "workspace:*",
    "@smart/ui": "workspace:*",
    "@smart/utils": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "0.18.0",
    "@tanstack/query-persist-client-core": "5.104.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "0.12.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "catalog:",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "date-fns": "4.4.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "catalog:",
