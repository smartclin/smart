{
  "name": "smart",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "auth:generate": "turbo run auth:generate -F @smart/auth --",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:admin": "cd scripts && bun --env-file=../apps/web/.env src/admin.ts",
    "db:fresh": " bun --env-file=apps/web/.env scripts/src/fresh.ts --force",
    "db:generate": "turbo run db:generate -F @smart/db --",
    "db:migrate": "turbo run db:migrate -F @smart/db --",
    "db:push": "turbo run db:push -F @smart/db --",
    "db:seed": "cd scripts && bun --env-file=../apps/web/.env src/seed.ts",
    "db:studio": "turbo run db:studio -F @smart/db --",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "fix": "ultracite fix"
  },
  "resolutions": {
    "cmdk/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "lucide-react": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@smart/config": "workspace:*",
    "@smart/env": "workspace:*",
    "@turbo/gen": "2.11.5",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "lint-staged": "17.6.0",
    "turbo": "2.11.5",
    "typescript": "catalog:",
    "ultracite": "7.12.1"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@faker-js/faker": "10.6.0",
    "@orpc/client": "1.15.4",
    "@orpc/openapi": "1.15.4",
    "@orpc/server": "1.15.4",
    "@orpc/zod": "1.15.4",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.6",
    "dotenv": "18.0.4",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "lucide-react": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
}
