{
  "git.autofetch": true,
"git.autofetchPeriod": 180,        // seconds — reduce network churn
"git.autorefresh": false,
"git.confirmSync": false,
"git.enableSmartCommit": true,
"git.enableCommitSigning": true,   // if you sign commits
"git.fetchOnPull": true,

"git.inputValidation": true,
"git.inputValidationLength": 72,
"git.inputValidationSubjectLength": 50,
"git.mergeEditor": true,
"git.openRepositoryInParentFolders": "always",  // ← monorepo: auto-detect
"git.pruneOnFetch": true,
"git.replaceTagsWhenPull": true,
"git.showActionButton": {
  "commit": true,
  "publish": true,
  "sync": true
},
"gitlens.currentLine.enabled": false,           // if using GitLens — reduce noise
"gitlens.hovers.enabled": false,
// Tailwind v4 — CSS-first config. Point at every styles.css entry.
"tailwindCSS.experimental.configFile": {
  "apps/web/src/styles.css": "apps/web/src/**/*.{ts,tsx}",
  "packages/ui/src/styles.css": "packages/ui/src/**/*.{ts,tsx}",
  "packages/ui/src/**/*.css": "packages/ui/src/**/*.{ts,tsx}"
},

// Class attribute names (yours is good — keep it)
"tailwindCSS.classAttributes": [
  "class",
  "className",
  "ngClass",
  "class:list",
  "tw",
  "clsx"
],

// Functions that produce class strings (yours is good — keep it)
"tailwindCSS.classFunctions": [
  "clsx",
  "classnames",
  "cva",
  "cn",
  "tw",
  "tv",
  "tw\\.[a-z]+"
],

// Regex-based extraction for template literals inside `cn(...)` etc.
"tailwindCSS.experimental.classRegex": [
  ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
  ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
  ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
  ["tw\\.[a-z]+\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
],

// Canonical class suggestions — catches `bg-white bg-opacity-50` → `bg-white/50`
"tailwindCSS.lint.suggestCanonicalClasses": "warning",
"tailwindCSS.lint.cssConflict": "error",  // bump from warning — real bugs
"tailwindCSS.lint.recommendedVariantOrder": "warning",
"tailwindCSS.lint.usedBlocklistedClass": "warning",

// Inline color swatches
"tailwindCSS.colorDecorators": true,
"tailwindCSS.hovers": true,
"tailwindCSS.showPixelEquivalents": true,
"tailwindCSS.rootFontSize": 16,

// Don't scan build output
"tailwindCSS.files.exclude": [
  "**/.git/**",
  "**/node_modules/**",
  "**/.output/**",
  "**/dist/**",
  "**/.turbo/**",
  "**/.tanstack/**",
  "**/coverage/**"
],"[typescript]": {
  "editor.defaultFormatter": "biomejs.biome",
  "editor.inlayHints.enabled": "onUnlessPressed"
},
"[typescriptreact]": {
  "editor.defaultFormatter": "biomejs.biome",
  "editor.inlayHints.enabled": "onUnlessPressed"
},
"search.exclude": {
  "**/.cache": true,
  "**/.git": true,
  "**/.next": true,
  "**/.output": true,
  "**/.tanstack": true,
  "**/.turbo": true,
  "**/.vinxi": true,
  "**/coverage": true,
  "**/dist": true,
  "**/node_modules": true,
  "**/routeTree.gen.ts": true,
  "**/bun.lock": true,
  "**/bun.lockb": true,
  "**/pnpm-lock.yaml": true,
  "**/package-lock.json": true,
  "**/yarn.lock": true,
  "docs": true
},

"search.followSymlinks": false,
"search.smartCase": true,
"search.useGlobalIgnoreFiles": true,
"search.useIgnoreFiles": true,
"search.useParentIgnoreFiles": true,   // ← new: respect .gitignore up the tree
"search.quickOpen.includeHistory": false,
"search.quickOpen.includeSymbols": true,

// Watcher — exclude build dirs so the file watcher doesn't choke
"files.watcherExclude": {
  "**/.git/objects/**": true,
  "**/.git/subtree-cache/**": true,
  "**/.output/**": true,
  "**/.tanstack/**": true,
  "**/.turbo/**": true,
  "**/.vinxi/**": true,
  "**/coverage/**": true,
  "**/dist/**": true,
  "**/node_modules/**": true,
  "**/routeTree.gen.ts": true,
  "**/bun.lock": true,
  "**/bun.lockb": true
},
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
  "quickfix.biome": "explicit",
  "source.fixAll": "explicit",
  "source.organizeImports.biome": "explicit",
  "source.fixAll.biome": "explicit"
},
// ===== TypeScript: Performance & Correctness =====

// Use the workspace TS version — critical in a monorepo.
// Combined with a root `typescript` dev dep, this makes editors match `bun run typecheck`.
"js/ts.tsdk.path": "node_modules/typescript/lib",
"js/ts.tsdk.promptToUseWorkspaceVersion": true,

// Project diagnostics reveal cross-package type errors, but they're slow.
// Enable when debugging a type error across packages, then turn off.
"js/ts.tsserver.experimental.enableProjectDiagnostics": false,

// Memory for large monorepos. 8 GB is generous; 4 GB is usually enough.
"js/ts.tsserver.maxMemory": 4096,

// Disable auto type acquisition — you use explicit `@types/*` deps.
"js/ts.tsserver.automaticTypeAcquisition.enabled": false,

// Auto-import uses your tsconfig paths (@smart/*, @/*, #/*)
"js/ts.preferences.importModuleSpecifier": "shortest",
"js/ts.preferences.importModuleSpecifierEnding": "minimal",
"js/ts.preferences.includePackageJsonAutoImports": "on",

// Quote style matches Biome's default
"js/ts.preferences.quoteStyle": "double",

// Prefer `import type` where possible — Biome enforces this too
"js/ts.preferences.preferTypeOnlyAutoImports": true,

// Update imports on rename/move — essential for monorepo refactors
"js/ts.updateImportsOnFileMove.enabled": "always",

// Suggest auto-imports, complete function calls with `()` + arg placeholders
"js/ts.suggest.autoImports": true,
"js/ts.suggest.completeFunctionCalls": true,
"js/ts.suggest.includeCompletionsForModuleExports": true,
"js/ts.suggest.includeCompletionsForImportStatements": true,
"js/ts.suggest.includeAutomaticOptionalChainCompletions": true,

// Show the source definition when jumping to a re-export
"js/ts.preferGoToSourceDefinition": true,

// Inlay hints — inline types. Toggle per-language below.
"js/ts.inlayHints.parameterNames.enabled": "literals",
"js/ts.inlayHints.parameterTypes.enabled": false,
"js/ts.inlayHints.variableTypes.enabled": false,
"js/ts.inlayHints.propertyDeclarationTypes.enabled": false,
"js/ts.inlayHints.functionLikeReturnTypes.enabled": false,
"js/ts.inlayHints.enumMemberValues.enabled": true,
"js/ts.inlayHints.typeParameterTypes.enabled": false,

// Auto-closing tags — disable for React (Biome formats JSX; tag help is noisy)
"js/ts.autoClosingTags.enabled": false,

// Localization
"js/ts.locale": "en",

// Logging — turn on only when debugging TS server
"js/ts.tsserver.log": "off",
"js/ts.tsserver.tracing.enabled": false,
"js/ts.server.showFailedResponses": "auto",
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[less]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.wordWrap": "off"
  },
  "[scss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

 // ===== React/JSX =====

// Wrap JSX attributes across lines when formatting
"editor.wordWrap": "off",  // keep as-is; JSX wraps via Biome

// Emmet in TSX
"emmet.includeLanguages": {
  "javascriptreact": "html",
  "typescriptreact": "html"
},
"emmet.showExpandedAbbreviation": "always",
"emmet.showSuggestionsAsSnippets": true,
"emmet.triggerExpansionOnTab": true,
"explorer.fileNesting.enabled": true,
"explorer.fileNesting.expand": false,
"explorer.fileNesting.patterns": {
  // Root configs
  "package.json": "package-lock.json, bun.lock, bun.lockb, .npmrc, .nvmrc, .node-version, .editorconfig, .gitattributes, commitlint.config.*, .oxlintrc*, biome.json*, .biomerc*, turbo.json*",
  "tsconfig.json": "tsconfig.*.json, env.d.ts, tsconfig.tsbuildinfo",
  "biome.json": ".biomeignore, biome.jsonc",

  // Vite / TanStack
  "vite.config.ts": "vite.config.*.ts, vitest.config.*, vite-env.d.ts, .env.vite*",
  "router.tsx": "routeTree.gen.ts",
  "app.config.ts": "app.config.*.ts",

  // Drizzle
  "schema.ts": "schema.*.ts, *.schema.ts",

  // Tests
  "*.test.ts": "*.test.tsx, *.spec.ts, *.spec.tsx",
  "*.test.tsx": "*.spec.tsx",

  // Env
  ".env": ".env.*, .env.example, .env.local, .env.development, .env.production",

  // Docker
  "Dockerfile": "Dockerfile.*, .dockerignore, docker-compose.*.yml, compose.*.yml"
},
// Suggest React hooks API — helps with the new `use` and concurrent APIs
 "[yaml]": {
